{
  "name": "@consultchimps/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/copy-database-browser-assets.ts && next build --webpack",
    "dev": "node ../../scripts/copy-database-browser-assets.ts && next dev --webpack",
    "e2e": "playwright test",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "postinstall": "fumadocs-mdx",
    "typecheck": "next typegen && fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "@consultchimps/core": "workspace:*",
    "@consultchimps/db": "workspace:*",
    "@consultchimps/messages": "workspace:*",
    "@consultchimps/pdf": "workspace:*",
    "@consultchimps/pptx": "workspace:*",
    "@consultchimps/tabular": "workspace:*",
    "@consultchimps/xlsx": "workspace:*",
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.12.1",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.12.1",
    "jszip": "3.10.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1"
  },
  "devDependencies": {
    "@consultchimps/theme": "workspace:*",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.1",
    "pdf-lib": "1.17.1",
    "postcss": "^8.5.26",
    "serve": "14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
