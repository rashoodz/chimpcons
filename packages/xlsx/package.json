{
  "name": "@consultchimps/xlsx",
  "version": "0.17.0",
  "description": "Excel workbook adapters, consolidation, and splitting for ConsultChimps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consultchimps/consultchimps.git",
    "directory": "packages/xlsx"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bytes": {
      "types": "./dist/bytes.d.ts",
      "import": "./dist/bytes.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "import": "./dist/stream.js"
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-LICENSES.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bytes.ts src/stream.ts --format esm --dts --clean",
    "prepack": "tsup src/index.ts src/bytes.ts src/stream.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@consultchimps/core": "workspace:*",
    "@consultchimps/files": "workspace:*",
    "@consultchimps/tabular": "workspace:*",
    "@zip.js/zip.js": "2.14.0",
    "jszip": "3.10.1",
    "saxes": "6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
