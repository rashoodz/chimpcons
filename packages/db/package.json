{
  "name": "@consultchimps/db",
  "version": "0.1.0",
  "description": "Persistent local SQLite and DuckDB databases, imports, deliveries, and validated conversion for ConsultChimps.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consultchimps/consultchimps.git",
    "directory": "packages/db"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts src/node.ts src/browser.ts --format esm --dts --clean",
    "prepack": "tsup src/index.ts src/schema.ts src/node.ts src/browser.ts --format esm --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@consultchimps/core": "workspace:*",
    "@consultchimps/files": "workspace:*",
    "@consultchimps/xlsx": "workspace:*",
    "@noble/hashes": "2.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@duckdb/node-api": "1.5.5-r.4",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@types/better-sqlite3": "9.6.0",
    "better-sqlite3": "13.0.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@duckdb/node-api": "1.5.5-r.4",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "better-sqlite3": "13.0.3"
  },
  "peerDependenciesMeta": {
    "@duckdb/node-api": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@duckdb/duckdb-wasm": {
      "optional": true
    },
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    }
  }
}
